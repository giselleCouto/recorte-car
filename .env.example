# Copie para .env e ajuste
INOVACAR_DATABASE_URL=postgresql://car:car@localhost:5432/car
INOVACAR_CACHE_BACKEND=memoria        # ou redis
INOVACAR_REDIS_URL=redis://localhost:6379/0
INOVACAR_CACHE_TTL_S=300
INOVACAR_LIMITE_REQ_POR_MINUTO=240
INOVACAR_LIMITE_PAGINA=500
INOVACAR_LIMITE_EXPORTACAO=20000
